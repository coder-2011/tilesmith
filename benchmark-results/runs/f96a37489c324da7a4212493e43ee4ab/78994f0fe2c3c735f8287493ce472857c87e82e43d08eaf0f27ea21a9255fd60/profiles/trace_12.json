      "data": {
        "additional_kwargs": {},
        "artifact": null,
        "content": "@triton.jit\ndef _bmm_1x64_64x64_kernel(lhs, rhs, out, BLOCK_N: tl.constexpr):\n    pid_n = tl.program_id(0)\n    pid_b = tl.program_id(1)\n    cols = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    ks = tl.arange(0, 64)\n    lhs_vals = tl.load(lhs + pid_b * 64 + ks)[:, None]\n    rhs_vals = tl.load(rhs + pid_b * 4096 + ks[:, None] * 64 + cols[None, :], mask=cols[None, :] < 64, other=0.0)\n    acc = tl.sum(lhs_vals * rhs_vals, axis=0)\n    tl.store(out + pid_b * 64 + cols, acc, mask=cols < 64)\n\n\ndef _bmm_1x64_64x64(lhs, rhs, out=None):\n    if out is None:\n        out = empty_strided_cuda((8, 1, 64), (64, 64, 1), torch.float32)\n    _bmm_1x64_64x64_kernel[(4, 8)](lhs, rhs, out, BLOCK_N=16, num_warps=1)\n    return out\n\n\nextern_kernels.bmm = _bmm_1x64_64x64\n\n\n",
